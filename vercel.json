{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {"api/index.mjs": {"maxDuration": 60}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api?path=:path*"}],
  "crons": [{"path": "/api/refresh", "schedule": "17 14 * * *"}],
  "headers": [{"source": "/(.*)", "headers": [
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"same-origin"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
  ]}]
}
