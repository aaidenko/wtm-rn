DATABASE_URL=postgresql://provided-by-neon
GROUP_CODE=choose-a-random-code-at-least-8-characters
CRON_SECRET=choose-a-different-random-secret-at-least-32-characters

# Optional dedicated personal Gmail inbox; app password requires 2-Step Verification.
WTM_INBOX_EMAIL=
WTM_INBOX_APP_PASSWORD=

# Optional Photon Stable cloud DM agent. Keep these server-side only.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=
# Google AI Studio free-tier key; leave billing disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
